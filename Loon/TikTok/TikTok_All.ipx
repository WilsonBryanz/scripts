#!name=TikTok 终极分流与换区
#!desc=集成 QUIC 精准阻断、核心域名路由分流，以及基于策略组节点的动态智能换区 JS 脚本。
#!icon=https://raw.githubusercontent.com/chxm1023/Script_X/main/icon/TikTok.png
#!author=WilsonBryanz

[Rule]
# 👇--- 1 精准阻断 TikTok QUIC (仅拦截 UDP 443，防真实 IP 泄露) ---
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,tiktok)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,byteoversea.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,ibyteimg.com)),REJECT-NO-DROP

# 👇--- 2 核心 API 正常走代理策略组 ---
DOMAIN-SUFFIX,tiktokv.com,TikTok
DOMAIN-SUFFIX,byteoversea.com,TikTok
DOMAIN-SUFFIX,ibyteimg.com,TikTok
DOMAIN-SUFFIX,tiktokcdn.com,TikTok
DOMAIN-KEYWORD,tiktok,TikTok
DOMAIN-SUFFIX,tiktok-row.net,TikTok

[Script]
# 👇--- 动态匹配节点智能换区 (新、美、日、台、欧) ---
# ⚠️ 请将此处的 script-path 替换为你部署在 Vercel 或 Github 的 JS 直链
http-request ^https?:\/\/(.+\.)?(tiktokv|byteoversea|tik-tokapi)\.com\/.+ script-path=github.com/WilsonBryanz/scripts/raw/refs/heads/main/Loon/TikTok/TikTok_Switcher.js, requires-body=false, tag=TikTok智能换区
