IP-ASN,11983,PROXY,no-resolve
IP-ASN,138699,PROXY,no-resolve

[Script]
# 👇--- 绝对不会 404 的 TikTok 远程动态重写 (支持 新、美、日、台、韩、英、欧盟 自动切换) ---
http-request ^https?:\/\/(.+\.)?(tiktokv|byteoversea|tik-tokapi)\.com\/.+ script-path=https://raw.githubusercontent.com/WilsonBryanz/scripts/refs/heads/main/Loon/TikTok/TikTok_Switcher.js, requires-body=false, tag=TikTok
