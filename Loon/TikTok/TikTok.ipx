#!name=TikTok 终极路由与动态换区
#!desc=集成 QUIC 精准阻断、核心路由分流，及智能换区脚本。请在下方【代理指向的策略】中，将 TikTok_Select_Node 绑定到你的 TikTok 节点策略组。
#!icon=https://raw.githubusercontent.com/chxm1023/Script_X/main/icon/TikTok.png
#!author=WilsonBryanz

[Rule]
# 👇--- 1 精准阻断 TikTok QUIC (仅拦截 UDP 443，绝不阻断 DNS 与 TCP) ---
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,tiktok)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,byteoversea.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,ibyteimg.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,snssdk.com)),REJECT-NO-DROP

# 👇--- 2 核心 API 正常走代理策略组 ---
DOMAIN-SUFFIX,byteoversea.com,TikTok_Select_Node
DOMAIN-SUFFIX,byteoversea.net,TikTok_Select_Node
DOMAIN-SUFFIX,ibytedtos.com,TikTok_Select_Node
DOMAIN-SUFFIX,ibyteimg.com,TikTok_Select_Node
DOMAIN-SUFFIX,ipstatp.com,TikTok_Select_Node
DOMAIN-SUFFIX,muscdn.com,TikTok_Select_Node
DOMAIN-SUFFIX,musical.ly,TikTok_Select_Node
DOMAIN-SUFFIX,sgpstatp.com,TikTok_Select_Node
DOMAIN-SUFFIX,snssdk.com,TikTok_Select_Node
DOMAIN-SUFFIX,tik-tokapi.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktok.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokcdn-com.akamaized.net,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokcdn-eu.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokcdn-eu.net,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokcdn-us.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokcdn.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokinfo.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokv.com,TikTok_Select_Node
DOMAIN-SUFFIX,tiktokv.us,TikTok_Select_Node
DOMAIN-KEYWORD,tiktok,TikTok_Select_Node
DOMAIN-KEYWORD,musical.ly,TikTok_Select_Node

[Script]
# 👇--- 绝对不会 404 的 TikTok 远程动态重写 (支持 新、美、日、台、韩、英、欧盟 自动切换) ---
http-request ^https?:\/\/(.+\.)?(tiktokv|byteoversea|tik-tokapi)\.com\/.+ script-path=https://raw.githubusercontent.com/WilsonBryanz/scripts/refs/heads/main/Loon/TikTok/TikTok_Switcher.js, requires-body=false, tag=TikTok
