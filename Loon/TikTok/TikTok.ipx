#!name=TikTok 终极路由与动态换区 (MitM 版)
#!desc=集成 QUIC 阻断、全量纯净分流及节点联动换区脚本（仅限去 SSL Pinning 版使用）。请将下方 PROXY 绑定到 TikTok 策略组。
#!icon=https://raw.githubusercontent.com/chxm1023/Script_X/main/icon/TikTok.png
#!raw-url=https://raw.githubusercontent.com/WilsonBryanz/scripts/refs/heads/main/Loon/TikTok/TikTok.ipx
#!author=WilsonBryanz

[Rule]
# 👇--- 1. 精准阻断 TikTok QUIC (仅拦截 UDP 443 强制回落 TCP，不伤 DNS 与国内抖音) ---
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,tiktokv.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,tiktokv.us)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,tiktokv.eu)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,tiktokcdn.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,tiktokcdn-us.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,tiktokcdn-eu.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,byteoversea.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,ibyteimg.com)),REJECT-NO-DROP

# 👇--- 2. 精确子域名 (TikTok 专用，避免放行整个国内字节主域名) ---
DOMAIN,p1-tt.byteimg.com,PROXY
DOMAIN,p1-tt-ipv6.byteimg.com,PROXY
DOMAIN,p3-tt-ipv6.byteimg.com,PROXY
DOMAIN,p9-tt.byteimg.com,PROXY
DOMAIN,p16-tt.byteimg.com,PROXY
DOMAIN,p26-tt.byteimg.com,PROXY
DOMAIN,p16-tiktokcdn-com.akamaized.net,PROXY
DOMAIN,musically.app.link,PROXY
DOMAIN,musically-alternate.app.link,PROXY

# 👇--- 3. TikTok 核心主域名与全区域接口 (美/欧/亚太/印) ---
DOMAIN-SUFFIX,tiktok.com,PROXY
DOMAIN-SUFFIX,tiktok.in,PROXY
DOMAIN-SUFFIX,tik-tokapi.com,PROXY
DOMAIN-SUFFIX,tiktokv.com,PROXY
DOMAIN-SUFFIX,tiktokv.us,PROXY
DOMAIN-SUFFIX,tiktokv.eu,PROXY
DOMAIN-SUFFIX,tiktokw.us,PROXY
DOMAIN-SUFFIX,tiktokd.net,PROXY
DOMAIN-SUFFIX,tiktokd.org,PROXY
DOMAIN-SUFFIX,tiktok-row.net,PROXY
DOMAIN-SUFFIX,tiktok-usts.net,PROXY
DOMAIN-SUFFIX,tiktokcdn.com,PROXY
DOMAIN-SUFFIX,tiktokcdn-us.com,PROXY
DOMAIN-SUFFIX,tiktokcdn-eu.com,PROXY
DOMAIN-SUFFIX,tiktokcdn-eu.net,PROXY
DOMAIN-SUFFIX,tiktokcdn-in.com,PROXY
DOMAIN-SUFFIX,tiktokstaticb.com,PROXY
DOMAIN-SUFFIX,tiktokshop.com,PROXY
DOMAIN-SUFFIX,tiktokglobalshop.com,PROXY
DOMAIN-SUFFIX,tiktokglobalshopv.com,PROXY
DOMAIN-SUFFIX,tiktokmusic.app,PROXY
DOMAIN-SUFFIX,musical.ly,PROXY
DOMAIN-SUFFIX,muscdn.com,PROXY

# 👇--- 4. 海外字节系网关 / 直播 / 特效 / WebView / 电商 ---
DOMAIN-SUFFIX,byteoversea.com,PROXY
DOMAIN-SUFFIX,byteoversea.net,PROXY
DOMAIN-SUFFIX,byteintl.com,PROXY
DOMAIN-SUFFIX,byteintl.net,PROXY
DOMAIN-SUFFIX,byteintlapi.com,PROXY
DOMAIN-SUFFIX,byteglb.com,PROXY
DOMAIN-SUFFIX,byteicdn.com,PROXY
DOMAIN-SUFFIX,byteigtm.com,PROXY
DOMAIN-SUFFIX,bytetcdn.com,PROXY
DOMAIN-SUFFIX,bytefcdn-oversea.com,PROXY
DOMAIN-SUFFIX,bytefcdn-ttpeu.com,PROXY
DOMAIN-SUFFIX,bytegecko-i18n.com,PROXY
DOMAIN-SUFFIX,bytedapm.com,PROXY
DOMAIN-SUFFIX,byteeffecttos-g.com,PROXY
DOMAIN-SUFFIX,ibytedtos.com,PROXY
DOMAIN-SUFFIX,ibyteimg.com,PROXY
DOMAIN-SUFFIX,ipstatp.com,PROXY
DOMAIN-SUFFIX,isnssdk.com,PROXY
DOMAIN-SUFFIX,sgpstatp.com,PROXY
DOMAIN-SUFFIX,sgsnssdk.com,PROXY
DOMAIN-SUFFIX,ttoversea.net,PROXY
DOMAIN-SUFFIX,ttoverseaus.net,PROXY
DOMAIN-SUFFIX,ttlivecdn.com,PROXY
DOMAIN-SUFFIX,tlivecdn.com,PROXY
DOMAIN-SUFFIX,tlivepush.com,PROXY
DOMAIN-SUFFIX,ttwstatic.com,PROXY
DOMAIN-SUFFIX,ttlstatic.com,PROXY
DOMAIN-SUFFIX,oecstatic.com,PROXY
DOMAIN-SUFFIX,pitaya-clientai.com,PROXY
DOMAIN-SUFFIX,ttwebview.com,PROXY
DOMAIN-SUFFIX,ttapis.com,PROXY
DOMAIN-SUFFIX,ttadsmanager.com,PROXY
DOMAIN-SUFFIX,ttdns2.com,PROXY
DOMAIN-SUFFIX,tzvbfs.com,PROXY

# 👇--- 5. 极简关键词兜底与 ASN ---
DOMAIN-KEYWORD,tiktokcdn-,PROXY
DOMAIN-KEYWORD,ttcdn-tos,PROXY
IP-ASN,11983,PROXY,no-resolve
IP-ASN,138699,PROXY,no-resolve

[Script]
# 👇--- TikTok 节点联动动态换区 (支持 新、美、日、台、韩、英、欧 自动切换) ---
http-request ^https?:\/\/(.+\.)?(tiktokv(\.us|\.eu)?|byteoversea|tik-tokapi)\.com\/.+ script-path=https://raw.githubusercontent.com/WilsonBryanz/scripts/refs/heads/main/Loon/TikTok/TikTok_Switcher.js, requires-body=false, tag=TikTok换区

[Mitm]
hostname = *.tiktokv.com, *.tiktokv.us, *.tiktokv.eu, *.byteoversea.com, *.tik-tokapi.com
