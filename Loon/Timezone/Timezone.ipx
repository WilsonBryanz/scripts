#!name=全端节点动态时区伪装 (国际白名单版)
#!desc=对包含 Grok、Claude 与领英在内的国际头部 AI、社媒及流媒体进行无感时区篡改。内置 QUIC 阻断引擎，确保 MitM 100% 触发。
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Clock.png
#!author=WilsonBryanz

[Rule]
# 👇 0. 强制核心应用回退 TCP (精准阻断 QUIC，确保解密与时区脚本 100% 命中)
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,google)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,youtube)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,meta)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,facebook)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,instagram)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-KEYWORD,twitter)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,x.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,grok.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,openai.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,claude.ai)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,anthropic.com)),REJECT-NO-DROP

[Script]
# 👇 1. App API 劫持层 (纯净真实直链，无任何参数)
http-request ^https?:\/\/(.+\.)?((openai|chatgpt|anthropic|midjourney|facebook|instagram|x|twitter|reddit|discord|snapchat|pinterest|youtube|netflix|disneyplus|hulu|max|primevideo|meta|grok|linkedin|browserleaks)\.com|(claude|perplexity|meta|mistral|x)\.ai|(whoer|pixelscan)\.net|twitch\.tv) script-path=https://raw.githubusercontent.com/WilsonBryanz/scripts/main/Loon/Timezone/Timezone_Smart.js, requires-body=false, tag=动态时区_API

# 👇 2. Web 网页注入层 (纯净真实直链，无任何参数)
http-response ^https?:\/\/(.+\.)?((openai|chatgpt|anthropic|midjourney|facebook|instagram|x|twitter|reddit|discord|snapchat|pinterest|youtube|netflix|disneyplus|hulu|max|primevideo|meta|grok|linkedin|browserleaks)\.com|(claude|perplexity|meta|mistral|x)\.ai|(whoer|pixelscan)\.net|twitch\.tv) script-path=https://raw.githubusercontent.com/WilsonBryanz/scripts/main/Loon/Timezone/Timezone_Smart.js, requires-body=true, tag=动态时区_网页

[Mitm]
# 👇 3. 证书解密白名单
hostname = *.openai.com, *.chatgpt.com, *.anthropic.com, *.midjourney.com, *.facebook.com, *.instagram.com, *.x.com, *.twitter.com, *.reddit.com, *.discord.com, *.snapchat.com, *.pinterest.com, *.youtube.com, *.netflix.com, *.disneyplus.com, *.hulu.com, *.max.com, *.primevideo.com, *.meta.com, *.grok.com, *.linkedin.com, *.browserleaks.com, *.whoer.net, *.pixelscan.net, *.claude.ai, *.perplexity.ai, *.meta.ai, *.mistral.ai, *.x.ai, *.twitch.tv
